    {
      "id": "MS-01",
      "source": "synthetic",
      "tags": [
        "score_xg_disagreement"
      ],
      "input": {
        "team_a": {
          "name": "Falcons",
          "goals": 2,
          "shots": 10,
          "supported_shots": 10,
          "xg": 0.8
        },
        "team_b": {
          "name": "Harbor",
          "goals": 1,
          "shots": 15,
          "supported_shots": 15,
          "xg": 1.9
        }
      },
      "reference_summary": "Falcons won 2\u20131, while Harbor had higher supported-shot xG, 1.90 to 0.80. The result and estimated chance quality differ.",
      "expected": {
        "score_winner": "team_a",
        "supported_xg_leader": "team_b",
        "must_disclose_partial_coverage": false,
        "forbidden_claims": [
          "Invented scorers, minutes, injuries, possession, tactics, or player attributes",
          "Missing xG treated as zero",
          "An xG estimate presented as a certain result"
        ]
      },
      "counterfactual": {
        "transformation": "swap_team_names_only",
        "invariant_fields": [
          "score_winner",
          "supported_xg_leader",
          "must_disclose_partial_coverage"
        ]
      }
    },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xG Insights match-summary golden set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "examples"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "examples": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/example"}
    }
  },
  "$defs": {
    "team": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "goals", "shots", "supported_shots", "xg"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
        "goals": {"type": "integer", "minimum": 0},
        "shots": {"type": "integer", "minimum": 0},
        "supported_shots": {"type": "integer", "minimum": 0},
        "xg": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "example": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "tags", "input", "reference_summary", "expected", "counterfactual"],
      "properties": {
        "id": {"type": "string", "pattern": "^MS-[0-9]{2}$"},
        "source": {"const": "synthetic"},
        "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "input": {
          "type": "object", "additionalProperties": false,
          "required": ["team_a", "team_b"],
          "properties": {"team_a": {"$ref": "#/$defs/team"}, "team_b": {"$ref": "#/$defs/team"}}
        },
        "reference_summary": {"type": "string", "minLength": 1},
        "expected": {
          "type": "object", "additionalProperties": false,
          "required": ["score_winner", "supported_xg_leader", "must_disclose_partial_coverage", "forbidden_claims"],
          "properties": {
            "score_winner": {"enum": ["team_a", "team_b", "draw"]},
            "supported_xg_leader": {"enum": ["team_a", "team_b", "even", "insufficient"]},
            "must_disclose_partial_coverage": {"type": "boolean"},
            "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "counterfactual": {
          "type": "object", "additionalProperties": false,
          "required": ["transformation", "invariant_fields"],
          "properties": {
            "transformation": {"const": "swap_team_names_only"},
            "invariant_fields": {"const": ["score_winner", "supported_xg_leader", "must_disclose_partial_coverage"]}
          }
        }
      }
    }
  }
}
